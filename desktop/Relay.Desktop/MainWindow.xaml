<Window x:Class="Relay.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relay Desktop Manager" Width="1160" Height="820" MinWidth="850" MinHeight="620"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        AutomationProperties.Name="Relay Desktop Manager">
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="16,13" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="NavBorder" CornerRadius="12" Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1">
          <ContentPresenter VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#F3EFFA" /></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource Ink}" /><Setter TargetName="NavBorder" Property="Background" Value="{StaticResource PrimaryFill}" /><Setter TargetName="NavBorder" Property="BorderBrush" Value="#C8B8EC" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavBorder" Property="BorderBrush" Value="{StaticResource Lavender}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,15,0,5" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="RowBackground" Value="Transparent" />
      <Setter Property="AlternatingRowBackground" Value="#FFF9F7FC" /><Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="HeadersVisibility" Value="Column" /><Setter Property="RowHeaderWidth" Value="0" />
      <Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" /><Setter Property="CanUserResizeRows" Value="False" />
      <Setter Property="IsReadOnly" Value="True" /><Setter Property="SelectionMode" Value="Single" />
      <Setter Property="SelectionUnit" Value="FullRow" /><Setter Property="MinRowHeight" Value="62" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#FFFFFF" /><Setter Property="Foreground" Value="#6B607E" />
      <Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="#DDD8E8" />
      <Setter Property="Padding" Value="12,13" /><Setter Property="FontWeight" Value="Normal" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="#EEEAF3" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRow">
        <Border x:Name="RowBorder" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
          <DataGridCellsPresenter />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#F7F3FC" /></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#EEE6FA" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="12,8" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
        <Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#F8F6FD" Offset="0" /><GradientStop Color="#F1ECFA" Offset="0.55" /><GradientStop Color="#F3F6FC" Offset="1" />
    </LinearGradientBrush></Grid.Background>
    <Grid.ColumnDefinitions><ColumnDefinition Width="206" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Rectangle Grid.ColumnSpan="2" IsHitTestVisible="False"><Rectangle.Fill><RadialGradientBrush Center="0.95,0.05" GradientOrigin="0.95,0.05" RadiusX="0.55" RadiusY="0.7">
      <GradientStop Color="#40B9A6F0" Offset="0" /><GradientStop Color="#00B9A6F0" Offset="1" />
    </RadialGradientBrush></Rectangle.Fill></Rectangle>
    <Rectangle Grid.ColumnSpan="2" IsHitTestVisible="False"><Rectangle.Fill><RadialGradientBrush Center="0.35,1" GradientOrigin="0.35,1" RadiusX="0.5" RadiusY="0.6">
      <GradientStop Color="#2EA0DCCF" Offset="0" /><GradientStop Color="#00A0DCCF" Offset="1" />
    </RadialGradientBrush></Rectangle.Fill></Rectangle>
    <Border Background="#CCFFFFFF" BorderBrush="#E3DDEE" BorderThickness="0,0,1,0" Padding="18,28,18,20">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="8,0,0,34">
          <StackPanel Orientation="Horizontal">
            <Grid Width="35" Height="35" Margin="0,0,10,0">
              <Ellipse Width="34" Height="34" Stroke="#B6A3CE" StrokeThickness="1" />
              <Ellipse Width="21" Height="21" Stroke="#8D71B8" StrokeThickness="2" />
              <Ellipse Width="7" Height="7" Fill="#26765A" />
              <Ellipse Width="5" Height="5" Fill="#8D71B8" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,1,1,0" />
            </Grid>
            <TextBlock Text="relay" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="DESKTOP MANAGER" FontSize="9" Foreground="#747082" Margin="1,12,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1">
          <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" IsChecked="{Binding IsDevices, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Devices" AutomationProperties.Name="Devices">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="Devices" /></StackPanel>
          </RadioButton>
          <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" IsChecked="{Binding IsDispatch, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Dispatch" AutomationProperties.Name="Dispatch">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="Dispatch" /></StackPanel>
          </RadioButton>
          <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" IsChecked="{Binding IsEnrollment, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Enrollment" AutomationProperties.Name="Enrollment">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="Enrollment" /></StackPanel>
          </RadioButton>
          <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" IsChecked="{Binding IsNetwork, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Network" AutomationProperties.Name="Network">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="Network" /></StackPanel>
          </RadioButton>
          <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" IsChecked="{Binding IsActivity, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Activity" AutomationProperties.Name="Activity">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="Activity" /></StackPanel>
          </RadioButton>
          <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" IsChecked="{Binding IsHelp, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Help" AutomationProperties.Name="Connection help">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="Connection help" /></StackPanel>
          </RadioButton>
        </StackPanel>
        <Border Grid.Row="3" CornerRadius="13" BorderBrush="#D6E3DE" BorderThickness="1" Padding="13,15" Background="#F4F8F6">
          <StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="#26765A" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="Private by design" FontWeight="SemiBold" FontSize="12" /></StackPanel>
            <TextBlock Text="Local network. Encrypted calls. Your devices." Style="{StaticResource MutedText}" FontSize="11" Margin="0,9,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,24,28,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Page}" FontSize="30" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,7,12,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Ellipse Width="6" Height="6" Fill="{Binding HubStatusBrush}" Margin="0,0,7,0" /><TextBlock Text="{Binding HubStatus}" FontSize="12" Foreground="{Binding HubStatusBrush}" /></StackPanel>
            <TextBlock Text="{Binding ListenerSummary}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,5,0,0" TextAlignment="Right" />
          </StackPanel>
          <Button Content="{Binding StartStopLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding ToggleHubCommand}" AutomationProperties.Name="Start or stop hub" MinWidth="98" />
        </StackPanel>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#FFF0F3" BorderBrush="#E8A5B5" BorderThickness="1" CornerRadius="12" Padding="15,12" Margin="0,16,0,0" Visibility="{Binding HasActiveEmergencies, Converter={StaticResource VisibleIf}}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding EmergencyBannerTitle}" Foreground="#A7223D" FontWeight="SemiBold" /><TextBlock Text="{Binding EmergencyBannerMessage}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="#863449" FontSize="12" Margin="0,5,0,0" /></StackPanel>
            <Button Grid.Column="1" Content="Review alerts" Style="{StaticResource DangerButton}" Command="{Binding NavigateCommand}" CommandParameter="Dispatch" VerticalAlignment="Center" Padding="13,8" />
          </Grid>
        </Border>
      </Grid>

      <!-- Devices -->
      <Grid Grid.Row="1" Visibility="{Binding IsDevices, Converter={StaticResource VisibleIf}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <UniformGrid Columns="3">
          <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="20,16"><StackPanel><TextBlock Text="ONLINE NOW" Foreground="#6B607E" FontSize="10" /><TextBlock Text="{Binding OnlineCount}" FontSize="30" Foreground="#26765A" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="20,16"><StackPanel><TextBlock Text="APPROVED DEVICES" Foreground="#6B607E" FontSize="10" /><TextBlock Text="{Binding ApprovedCount}" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="20,16"><StackPanel><TextBlock Text="AWAITING APPROVAL" Foreground="#6B607E" FontSize="10" /><TextBlock Text="{Binding PendingCount}" FontSize="30" Foreground="#8F601E" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
        </UniformGrid>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="270" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="16">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="148" /></Grid.ColumnDefinitions>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search devices" ToolTip="Search by name, address, or fingerprint" />
                <ComboBox x:Name="DeviceFilter" Grid.Column="2" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" AutomationProperties.Name="Filter devices"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#241D39" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              </Grid>
              <TextBlock Text="Search devices" IsHitTestVisible="False" Foreground="#756B86" Margin="13,0,170,0" VerticalAlignment="Center">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
              <WrapPanel Grid.Row="1" Margin="0,8,0,8">
                <Button Content="Call selected" Command="{Binding CallSelectedCommand}" Style="{StaticResource MintButton}" Padding="12,8" Margin="0,0,8,0" />
                <Button Content="Talk to all" Command="{Binding TalkToAllCommand}" Padding="12,8" />
              </WrapPanel>
              <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredDevices}" SelectedItem="{Binding SelectedDevice}" AutomationProperties.Name="Enrolled devices" Visibility="{Binding HasDevices, Converter={StaticResource VisibleIf}}">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="DEVICE" Width="*" MinWidth="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /><TextBlock Text="{Binding IdentityShort}" FontFamily="Consolas" FontSize="10" Foreground="#6B607E" Margin="0,5,0,0" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="PRESENCE" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Presence}" Foreground="{Binding PresenceBrush}" FontSize="12" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="ACCESS" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Trust}" Foreground="{Binding TrustBrush}" FontSize="12" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleIf}}">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="280" Margin="8,18">
                <Grid Width="64" Height="64" Margin="0,0,0,24" Visibility="{Binding ShowEmptyIllustration, Converter={StaticResource VisibleIf}}"><Ellipse Stroke="#BBAACC" StrokeThickness="1" /><Ellipse Width="40" Height="40" Stroke="#8D71B8" StrokeThickness="2" /><Ellipse Width="12" Height="12" Fill="#26765A" /></Grid>
                <TextBlock Text="Bring your devices together" TextAlignment="Center" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="Start the hub, create an invitation, and scan it in Relay on your phone." TextAlignment="Center" Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,14" />
                <Button Content="Enroll a device" Command="{Binding NavigateCommand}" CommandParameter="Enrollment" Style="{StaticResource PrimaryButton}" />
              </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Grid>
                <StackPanel Visibility="{Binding NoSelection, Converter={StaticResource VisibleIf}}" Margin="0,12">
                  <TextBlock Text="Device details" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Select a device to review its identity, approve access, or update its local alias." Style="{StaticResource MutedText}" FontSize="13" Margin="0,12,0,0" />
                  <Border BorderBrush="#DDD8E8" BorderThickness="0,1,0,0" Margin="0,25,0,16" />
                  <TextBlock Text="Phone-to-phone calls require mutual pairing. Desktop calls ask the phone to answer." Style="{StaticResource MutedText}" FontSize="12" />
                </StackPanel>
                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource VisibleIf}}">
                  <TextBlock Text="{Binding SelectedDevice.DisplayName}" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SelectedDevice.Status}" Foreground="#26765A" FontSize="12" Margin="0,7,0,0" />
                  <TextBlock Text="{Binding SelectedDevice.CapabilitiesText}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0" />
                  <Button Content="Call this device" Style="{StaticResource MintButton}" Command="{Binding CallSelectedCommand}" Margin="0,12,0,0" />
                  <TextBlock Text="LOCAL ALIAS" Style="{StaticResource FieldLabel}" />
                  <TextBox Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.Name="Device local alias" />
                  <Button Content="Save alias" Command="{Binding SaveAliasCommand}" Margin="0,8,0,0" />
                  <TextBlock Text="REPORTED BY DEVICE" Style="{StaticResource FieldLabel}" />
                  <TextBlock Text="{Binding SelectedDevice.Name}" FontSize="13" /><TextBlock Text="{Binding SelectedDevice.AppVersion, StringFormat=Relay {0}}" FontSize="12" Foreground="#666076" Margin="0,3,0,0" />
                  <TextBlock Text="REPORTED ADDRESSES" Style="{StaticResource FieldLabel}" />
                  <TextBlock Text="{Binding SelectedDevice.AddressText}" FontFamily="Consolas" FontSize="12" />
                  <TextBlock Text="LAST SEEN" Style="{StaticResource FieldLabel}" />
                  <TextBlock Text="{Binding SelectedDevice.LastSeen}" FontSize="12" />
                  <TextBlock Text="CERTIFICATE FINGERPRINT" Style="{StaticResource FieldLabel}" />
                  <TextBox Text="{Binding SelectedDevice.Fingerprint, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" AutomationProperties.Name="Selected device fingerprint" />
                  <Button Content="Copy fingerprint" Command="{Binding CopyDeviceFingerprintCommand}" Margin="0,8,0,0" />
                  <Border BorderBrush="#DDD8E8" BorderThickness="0,1,0,0" Margin="0,20,0,16" />
                  <Button Content="Approve access" Style="{StaticResource MintButton}" Command="{Binding ApproveCommand}" />
                  <Button Content="Reject enrollment" Command="{Binding RejectCommand}" Margin="0,8,0,0" />
                  <Button Content="Revoke hub access" Command="{Binding RevokeCommand}" Foreground="#B42340" Margin="0,8,0,0" />
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>

      <!-- Dispatch -->
      <ScrollViewer x:Name="DispatchScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsDispatch, Converter={StaticResource VisibleIf}}">
        <StackPanel>
          <Border Background="#FFF0F3" BorderBrush="#E8A5B5" BorderThickness="1" CornerRadius="20" Padding="22" Margin="0,16,0,0" Effect="{StaticResource SoftShadow}" Visibility="{Binding HasActiveEmergencies, Converter={StaticResource VisibleIf}}">
            <StackPanel>
              <TextBlock Text="Active SOS and emergency alerts" FontSize="20" FontWeight="SemiBold" Foreground="#A7223D" />
              <ItemsControl ItemsSource="{Binding ActiveEmergencies}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                <Border BorderBrush="#EDC6D0" BorderThickness="0,1,0,0" Padding="0,15"><StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#95253E" /><TextBlock Grid.Column="1" Text="{Binding CreatedAt}" FontSize="11" Foreground="#80485A" /></Grid>
                  <TextBlock Text="{Binding Message}" Foreground="#80485A" Margin="0,8,0,0" />
                  <Button Content="Mark resolved" Command="{Binding DataContext.ResolveEmergencyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel></Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="A voice from your desktop" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Select a device on the Devices page for a two-way call. Talk to all sends a one-way announcement to available enrolled devices." Style="{StaticResource MutedText}" FontSize="13" />
              <WrapPanel Margin="0,18,0,0">
                <Button Content="Call selected device" Style="{StaticResource MintButton}" Command="{Binding CallSelectedCommand}" Margin="0,0,10,8" />
                <Button Content="Talk to all" Style="{StaticResource PrimaryButton}" Command="{Binding TalkToAllCommand}" Margin="0,0,10,8" />
                <Button Content="End dispatch" Command="{Binding EndDispatchCommand}" Margin="0,0,0,8" />
                <Button Content="Emergency…" Style="{StaticResource DangerButton}" Command="{Binding EmergencyBroadcastCommand}" Margin="10,0,0,8" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="{Binding DispatchModeLabel}" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold" />
              <TextBlock Text="{Binding DispatchTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0" />
              <TextBlock Text="{Binding DispatchHint}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,8,0,0" />
              <Button x:Name="TalkButton" Content="{Binding TalkLabel}" Background="{Binding TalkBackground}" Foreground="{Binding TalkForeground}"
                      BorderBrush="#C8B8EC" IsEnabled="{Binding CanTalk}" MinHeight="92" FontSize="18" Margin="0,20,0,0"
                      PreviewMouseLeftButtonDown="OnTalkMouseDown" PreviewMouseLeftButtonUp="OnTalkMouseUp" LostMouseCapture="OnTalkLostCapture"
                      PreviewKeyDown="OnTalkKeyDown" LostKeyboardFocus="OnTalkLostFocus"
                      AutomationProperties.Name="Hold to talk" ToolTip="Hold the mouse button, or focus this button and hold Space. Release to listen." />
              <TextBlock Text="{Binding AudioStatus}" TextAlignment="Center" Foreground="#536273" FontSize="12" Margin="0,10,0,0" />
              <TextBlock Text="Mouse or keyboard: hold this button or hold Space while it is focused. Your microphone opens only after the hub grants your turn." Style="{StaticResource MutedText}" FontSize="12" TextAlignment="Center" Margin="0,8,0,0" />
              <UniformGrid Columns="3" Margin="0,20,0,0">
                <StackPanel><TextBlock Text="CONNECTED" FontSize="10" Foreground="#666076" /><TextBlock Text="{Binding ConnectedRecipients}" FontSize="25" Foreground="#26765A" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                <StackPanel><TextBlock Text="WAITING" FontSize="10" Foreground="#666076" /><TextBlock Text="{Binding PendingRecipients}" FontSize="25" Foreground="#795A9E" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                <StackPanel><TextBlock Text="OTHER / SKIPPED" FontSize="10" Foreground="#666076" /><TextBlock Text="{Binding SkippedRecipients}" FontSize="25" Foreground="#8F601E" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
              </UniformGrid>
              <ItemsControl ItemsSource="{Binding DispatchParticipants}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                <Border BorderBrush="#E6DFEC" BorderThickness="0,1,0,0" Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Reason}" Foreground="#666076" FontSize="12" Margin="0,4,0,0" /></StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{Binding StateBrush}" FontSize="12" VerticalAlignment="Center" />
                </Grid></Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock Text="No dispatch has been started yet." Style="{StaticResource MutedText}" FontSize="12" Margin="0,15,0,0" Visibility="{Binding NoDispatchParticipants, Converter={StaticResource VisibleIf}}" />
              <TextBlock Text="{Binding DeliveryNote}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,15,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <Grid><TextBlock Text="Audio devices" FontSize="18" FontWeight="SemiBold" /><Button Content="Refresh devices" Command="{Binding RefreshAudioCommand}" HorizontalAlignment="Right" Padding="12,7" MinHeight="34" /></Grid>
              <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="MICROPHONE" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="InputDevicePicker" ItemsSource="{Binding InputDevices}" SelectedValuePath="Index" SelectedValue="{Binding SelectedInput}" IsEnabled="{Binding CanChangeAudio}" AutomationProperties.Name="Microphone input"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#27243B" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="SPEAKER / HEADSET" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="OutputDevicePicker" ItemsSource="{Binding OutputDevices}" SelectedValuePath="Index" SelectedValue="{Binding SelectedOutput}" IsEnabled="{Binding CanChangeAudio}" AutomationProperties.Name="Speaker or headset output"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#27243B" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
              </Grid>
              <TextBlock Text="{Binding AudioAvailability}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
          <Border Background="#FFF7F9" BorderBrush="#EAB9C5" BorderThickness="1" CornerRadius="20" Padding="22" Margin="0,16,0,0" Effect="{StaticResource SoftShadow}">
            <StackPanel>
              <TextBlock Text="Emergency broadcast" FontSize="20" FontWeight="SemiBold" Foreground="#A7223D" />
              <TextBlock Text="Send an emergency text alert, or start a priority voice announcement that can interrupt phone calls. Device volume and system restrictions still apply." Foreground="#80485A" FontSize="13" Margin="0,10,0,0" />
              <TextBox Text="{Binding EmergencyMessage, UpdateSourceTrigger=PropertyChanged}" MaxLength="240" Margin="0,16,0,0" AutomationProperties.Name="Emergency message" />
              <WrapPanel Margin="0,14,0,0"><Button Content="Send emergency text alert" Command="{Binding SendEmergencyAlertCommand}" Style="{StaticResource DangerButton}" Margin="0,0,10,8" /><Button Content="Emergency voice broadcast…" Command="{Binding EmergencyBroadcastCommand}" Style="{StaticResource DangerButton}" Margin="0,0,0,8" /></WrapPanel>
              <TextBlock Text="Alerts remain active until resolved. Ending voice does not resolve an emergency alert." Foreground="#80485A" FontSize="12" Margin="0,5,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Enrollment -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsEnrollment, Converter={StaticResource VisibleIf}}">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Invite a Relay device" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Each invitation works once and expires after 10 minutes. You review the device before it gains hub access." Style="{StaticResource MutedText}" FontSize="13" />
                <TextBlock Text="HUB ADDRESS FOR THIS PHONE" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="HubAdvertiseAddress" ItemsSource="{Binding InterfaceAddresses}" SelectedValuePath="Address" SelectedValue="{Binding AdvertiseAddress}" AutomationProperties.Name="Advertised hub address"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" Foreground="#241D39" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                <TextBlock Text="Choose a listening address the phone can reach, including from its own subnet." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0" />
                <Button Content="Generate invitation" Style="{StaticResource PrimaryButton}" Command="{Binding CreateEnrollmentCommand}" HorizontalAlignment="Left" Margin="0,20,0,0" />
                <TextBlock Text="{Binding EnrollmentExpiry}" Foreground="#26765A" FontSize="12" Margin="0,13,0,0" />
                <TextBlock Text="1. On the phone, open Relay → Settings → Desktop manager.&#x0a;&#x0a;2. Scan this code and approve the hub identity.&#x0a;&#x0a;3. Return to Devices here and approve the enrollment." Style="{StaticResource MutedText}" FontSize="13" Margin="0,25,0,0" />
              </StackPanel>
              <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="16" VerticalAlignment="Top" MinHeight="280">
                <Grid>
                  <Image Source="{Binding QrImage}" Width="248" Height="248" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Visibility="{Binding HasEnrollment, Converter={StaticResource VisibleIf}}" AutomationProperties.Name="Hub enrollment QR code" />
                  <StackPanel VerticalAlignment="Center" Visibility="{Binding NoEnrollment, Converter={StaticResource VisibleIf}}">
                    <TextBlock Text="&#xED14;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="#A296B5" HorizontalAlignment="Center" Margin="0,0,0,18" />
                    <TextBlock Text="Your invitation appears here" Foreground="#5A4D6F" FontSize="13" TextAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="Manual setup and identity" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Paste the invitation into the phone’s Desktop manager setup, or compare the full hub fingerprint." Style="{StaticResource MutedText}" FontSize="13" Margin="0,8,0,0" />
              <TextBlock Text="INVITATION LINK" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding EnrollmentUri, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" AutomationProperties.Name="Enrollment link" />
              <Button Content="Copy invitation" Command="{Binding CopyEnrollmentCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
              <TextBlock Text="HUB CERTIFICATE FINGERPRINT" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding Fingerprint, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" AutomationProperties.Name="Hub certificate fingerprint" />
              <Button Content="Copy hub fingerprint" Command="{Binding CopyFingerprintCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Network -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsNetwork, Converter={StaticResource VisibleIf}}">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Listening interfaces" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Stop the hub before applying changes. Use explicit private addresses and approve only the subnets that need Relay access." Style="{StaticResource MutedText}" FontSize="13" />
              <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="LISTEN ADDRESSES · ONE PER LINE" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding ListenAddresses, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditNetwork}" AcceptsReturn="True" Height="100" VerticalContentAlignment="Top" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Listen addresses" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="APPROVED SUBNETS · CIDR, ONE PER LINE" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding AllowedCidrs, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditNetwork}" AcceptsReturn="True" Height="100" VerticalContentAlignment="Top" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Approved subnets" /></StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <StackPanel Width="130"><TextBlock Text="TCP PORT" Foreground="#666076" FontSize="12" Margin="0,0,0,5" /><TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditNetwork}" MaxLength="5" AutomationProperties.Name="Hub TCP port" /></StackPanel>
                <Button Content="Save settings" Command="{Binding SaveNetworkCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="16,0,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <Grid><TextBlock Text="Available private addresses" FontSize="18" FontWeight="SemiBold" /><Button Content="Refresh" Command="{Binding RefreshInterfacesCommand}" HorizontalAlignment="Right" Padding="13,7" MinHeight="34" /></Grid>
              <ItemsControl ItemsSource="{Binding InterfaceAddresses}" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                <Border BorderBrush="#DDD8E8" BorderThickness="0,0,0,1" Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Address}" FontFamily="Consolas" FontSize="14" /><TextBlock Text="{Binding Name}" Foreground="#666076" FontSize="12" Margin="0,4,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Cidr}" FontFamily="Consolas" FontSize="12" Foreground="#26765A" VerticalAlignment="Center" /></Grid></Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock Text="If no address appears, connect this PC to a private Wi-Fi or Ethernet network." Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
            <TextBlock Text="Connection diagnostics" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Diagnostics}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,13,0,16" />
            <Button Content="Check local listener" Command="{Binding DiagnosticsCommand}" HorizontalAlignment="Left" />
          </StackPanel></Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Activity -->
      <Border Grid.Row="1" Style="{StaticResource Card}" Visibility="{Binding IsActivity, Converter={StaticResource VisibleIf}}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,18"><TextBlock Text="Hub activity" Style="{StaticResource SectionTitle}" /><TextBlock Text="Newest events first. Logs contain connection metadata, never voice or invitation tokens." Style="{StaticResource MutedText}" FontSize="13" /></StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding Activity}" Background="Transparent" BorderThickness="0" Foreground="#52495F" FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Hub activity log">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0,10" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border BorderBrush="#E6DFEC" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Help -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsHelp, Converter={StaticResource VisibleIf}}">
        <StackPanel>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Different subnets, one Relay hub" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Phones can talk directly when their router permits it. When they cannot reach each other, both connect outward to this PC and Relay forwards their encrypted connection." Style="{StaticResource MutedText}" FontSize="14" />
            <Border Background="#F5F1FC" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,20,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PHONE A" FontSize="10" Foreground="#666076" HorizontalAlignment="Center" /><TextBlock Text="Subnet A" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="→" FontSize="24" Foreground="#26765A" VerticalAlignment="Center" HorizontalAlignment="Center" /><StackPanel Grid.Column="2"><TextBlock Text="RELAY HUB" FontSize="10" Foreground="#666076" HorizontalAlignment="Center" /><TextBlock Text="This PC" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0" /></StackPanel><TextBlock Grid.Column="3" Text="←" FontSize="24" Foreground="#26765A" VerticalAlignment="Center" HorizontalAlignment="Center" /><StackPanel Grid.Column="4"><TextBlock Text="PHONE B" FontSize="10" Foreground="#666076" HorizontalAlignment="Center" /><TextBlock Text="Subnet B" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0" /></StackPanel></Grid></Border>
            <TextBlock Text="Both phones must be allowed to reach this PC. Relay does not change router rules, bridge adapters, or bypass client isolation." Style="{StaticResource MutedText}" FontSize="13" />
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
            <TextBlock Text="Before you connect" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="1. Give the PC a stable private address, ideally with a DHCP reservation.&#x0a;&#x0a;2. In Network, select its listening address and add each approved phone subnet.&#x0a;&#x0a;3. Allow inbound TCP on the hub port in Windows Firewall, scoped to those subnets. Permit phone-to-PC traffic in the router or VLAN firewall.&#x0a;&#x0a;4. Start the hub, enroll each phone, then pair the phones inside Relay." Style="{StaticResource MutedText}" FontSize="13" Margin="0,14,0,0" />
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
            <TextBlock Text="Keep the hub available" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding BackgroundHint}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,12,0,0" />
            <TextBlock Text="Relayed calls stop if the PC sleeps, restarts, or loses its network. Existing direct calls do not depend on the hub. Android force-stop still prevents incoming calls until Relay is opened again." Style="{StaticResource MutedText}" FontSize="13" Margin="0,12,0,0" />
            <TextBlock Text="This desktop profile and the separate headless host share one hub identity. Run only one host for a profile at a time." Style="{StaticResource MutedText}" FontSize="13" Margin="0,12,0,0" />
            <Button Content="Open local hub profile" Command="{Binding OpenProfileCommand}" HorizontalAlignment="Left" Margin="0,18,0,0" />
          </StackPanel></Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" BorderBrush="#E3DDEE" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,14,0,16">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Notice}" Foreground="{Binding NoticeBrush}" FontSize="12" Margin="0,0,15,0" VerticalAlignment="Center" AutomationProperties.Name="Status message" />
          <TextBlock Grid.Column="1" Text="LOCAL · ENCRYPTED" Foreground="#747082" FontSize="9" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
